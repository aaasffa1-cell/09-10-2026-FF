# ==========================================================
# FREE FIRE ARENA ENVIRONMENT CONFIGURATION
# ==========================================================

# Application Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Example: postgresql://postgres:password@localhost:5432/freefire_arena
DATABASE_URL=

# Razorpay Payment Gateway Credentials (Test / Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email SMTP Credentials (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Free Fire Arena <support@freefirearena.com>"

# JWT / Session Secret
SESSION_SECRET=freefire_arena_super_secret_jwt_key_2026_xyz987

# Initial Admin Credentials (used during DB seed/setup)
ADMIN_EMAIL=admin@freefirearena.com
ADMIN_PASSWORD=admin123456

# Timezone (Asia/Kolkata)
TZ=Asia/Kolkata
