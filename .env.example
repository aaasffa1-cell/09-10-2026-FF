# ==============================================================================
# FREE FIRE ARENA - ENVIRONMENT CONFIGURATION FOR VERCEL & PRODUCTION
# ==============================================================================

# PostgreSQL Database (Cloud Postgres from Neon.tech, Supabase, Railway, etc.)
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# SSL Mode (Set to true or let auto-detect from connection string)
DB_SSL=true

# Razorpay Payment Gateway (Test or Live credentials from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email SMTP Credentials (Gmail App Password: https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM="Free Fire Arena <support@freefirearena.com>"

# Security & JWT Token Secret (Random secure string)
SESSION_SECRET=ffa_production_secret_key_change_me_987654321

# Initial Admin Credentials (populated on database seed)
ADMIN_EMAIL=admin@freefirearena.com
ADMIN_PASSWORD=admin123456

# Cron Secret (Optional secret to secure /api/cron/check-rooms)
CRON_SECRET=ffa_cron_secure_secret_2026

# Timezone (Default: Asia/Kolkata)
TZ=Asia/Kolkata

# Node Environment
NODE_ENV=production

# Frontend API URL (Only needed if frontend and backend are hosted on separate domains)
# For fullstack Vercel deployment, leave blank to use automatic relative /api
VITE_API_URL=
